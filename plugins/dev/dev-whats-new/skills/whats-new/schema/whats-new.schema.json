{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://administracionattrim.github.io/dev-plugins/plugins/dev/dev-whats-new/skills/whats-new/schema/whats-new.schema.json",
  "title": "whats-new.json",
  "description": "Novedades por versión que la app muestra una sola vez al usuario (carrusel modal). Contrato del plugin dev-whats-new, schemaVersion 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "releases": {
      "description": "Todas las versiones con novedades, de la más reciente a la más antigua. La app solo pinta la última aplicable; el histórico sirve para una página de novedades.",
      "type": "array",
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "items"],
      "properties": {
        "version": {
          "description": "Versión semántica final (sin sufijo -SNAPSHOT/-rc).",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "date": {
          "description": "Fecha de publicación prevista (YYYY-MM-DD).",
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "items": {
          "description": "Entre 1 y 3 novedades, en orden de relevancia. Una versión sin novedades de usuario no lleva entrada.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "body"],
      "dependentRequired": { "video": ["image"] },
      "properties": {
        "id": {
          "description": "Identificador estable en kebab-case, único dentro de la versión.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 60
        },
        "title": { "$ref": "#/$defs/title" },
        "body": { "$ref": "#/$defs/body" },
        "icon": {
          "description": "Nombre de icono en kebab-case; cada proyecto lo traduce a su librería (p. ej. Lucide).",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "image": {
          "description": "Ruta relativa a la carpeta de assets (sin barra inicial) o URL https. Si falta, la cabecera es un degradado + icono.",
          "type": "string",
          "pattern": "^(https://\\S+|[^/\\s][^\\s]*\\.(png|jpe?g|webp|gif|svg|avif))$"
        },
        "imageAlt": { "$ref": "#/$defs/title" },
        "video": {
          "description": "Vídeo corto en bucle de la funcionalidad (MP4/WebM, sin audio), relativo a assets o URL https. Requiere \"image\" como póster: es lo que se ve mientras carga y con \"reducir movimiento\".",
          "type": "string",
          "pattern": "^(https://\\S+|[^/\\s][^\\s]*\\.(mp4|webm))$"
        },
        "link": { "$ref": "#/$defs/link" },
        "permit": {
          "description": "Permiso genérico que el proyecto resuelve a su manera. Si el usuario no lo tiene, el item no se muestra.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "link": {
      "description": "Enlace 'Saber más': ruta interna (route) o URL externa (href), nunca ambas.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "route"],
          "properties": {
            "label": { "$ref": "#/$defs/label" },
            "route": { "type": "string", "pattern": "^/\\S*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "href"],
          "properties": {
            "label": { "$ref": "#/$defs/label" },
            "href": { "type": "string", "pattern": "^https?://\\S+$" }
          }
        }
      ]
    },
    "title": {
      "oneOf": [
        { "type": "string", "minLength": 3, "maxLength": 70 },
        { "$ref": "#/$defs/localizedTitle" }
      ]
    },
    "body": {
      "oneOf": [
        { "type": "string", "minLength": 10, "maxLength": 320 },
        { "$ref": "#/$defs/localizedBody" }
      ]
    },
    "label": {
      "oneOf": [
        { "type": "string", "minLength": 2, "maxLength": 40 },
        { "$ref": "#/$defs/localizedLabel" }
      ]
    },
    "localizedTitle": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": { "type": "string", "minLength": 3, "maxLength": 70 }
    },
    "localizedBody": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": { "type": "string", "minLength": 10, "maxLength": 320 }
    },
    "localizedLabel": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": { "type": "string", "minLength": 2, "maxLength": 40 }
    }
  }
}
